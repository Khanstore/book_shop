<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_backorder_confirmation" model="ir.ui.view">
            <field name="name">stock_backorder_confirmation</field>
            <field name="model">stock.backorder.confirmation</field>
            <field name="inherit_id" ref="stock.view_backorder_confirmation"/>
            <field name="arch" type="xml">
                <button name="process_cancel_backorder" position="before">
                    <button name="force_availability" string="Force Availability And process" type="object" class="btn-danger text-uppercase"  />
                </button>
            </field>
        </record>
        <record id="view_picking_confirmation_wizard" model="ir.ui.view">
        <field name="name">picking.confirmation.wizard.form</field>
        <field name="model">picking.confirmation.wizard</field>
        <field name="arch" type="xml">
            <form string="Do You want to force availability">
                <group >
                    <span >Do You want to force availability</span>
                </group>
                <footer>
                    <button string="Yes" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="No" type="object" name="action_cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    </data>
</odoo>