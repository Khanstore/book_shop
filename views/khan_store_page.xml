<odoo>
    <template id="multi_product_page">
        <t t-foreach="products" t-as="product">
                                <div data-name="Card" class="col-lg-2 col-6 mb-4">
                                    <div class="product-card card" data-snippet="s_card" data-vxml="001"
                                         data-name="Card">
                                        <div class="product-card-image-wrapper">
                                            <a t-att-href="'/customs/product/%s' % product.id" aria-label="Link to product">
                                                <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"
                                                     t-att-alt="category.name"
                                                     class="product-card-image"/>
                                                <div class="product-overlay">
                                                <h3 class="product-title" t-esc="product.name"/>
                                            </div>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </t>
    </template>

    <template id="multi_category_page">
        <div data-name="Card" class="col-lg-2 col-6 mb-4">
            <div class="product-card card" data-snippet="s_card" data-vxml="001"
                 data-name="Card">
                <div class="product-card-image-wrapper">
                    <a t-att-href="'/shop/category/%s' % category.id" aria-label="Link to product">
                        <img t-att-src="'/web/image/product.public.category/%s/image_512' % category.id"
                             t-att-alt="category.name"
                             class="product-card-image"/>
                        <div class="product-overlay">
                        <h3 class="product-title" t-esc="category.name"/>
                    </div>
                    </a>

                </div>
            </div>
        </div>
    </template>

    <template id="custom_page_templates" name="Custom Web Page">
        <!-- inherit website layout for header/footer -->
        <t t-call="website.layout">
            <div class="container py-5">
                <section class="s_product_list pt64 pb64" data-vcss="001">
                    <div class="container">

                        <div class="row s_nb_column_fixed">
                            <div class="col-lg-12">
                                <h2 class="h3-fs">Our finest Collections</h2>
                            </div>
                            <t t-foreach="categories" t-as="category">
                                <t t-call="book_shop.multi_category_page"/>
                            </t>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="category_page_templates" name="Custom Web Page">
        <!-- inherit website layout for header/footer -->
        <t t-call="website.layout">
            <div class="container py-5">
                <section class="s_product_list pt64 pb64" data-vcss="001">
                    <div class="container">
                        <t t-if="category">
                            <div class="row s_nb_column_fixed">
                             <div class="col-lg-12">
                                <h2 class="h3-fs"><t t-esc="category.name"/></h2>

                            </div>
                                <t t-call="book_shop.multi_product_page"/>
                            </div>
                        </t>

                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
