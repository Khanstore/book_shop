<odoo>
    <data>
        <record id="book_shop_res_thana_view" model="ir.ui.view">
            <field name="name">book.shop.res.thana.view</field>
            <field name="model">res.thana</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
<!--                                <field name="code"/>-->
                            </group>
                            <group>
                                <field name="state_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_res_partner_kanban_inherit_thana" model="ir.ui.view">
            <field name="name">res.partner.kanban.thana</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.res_partner_kanban_view"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban" position="inside">
                    <field name="thana_id"/>
                    <field name="state_id"/>
                </xpath>

                <xpath expr="//div[hasclass('mb-1')]/following-sibling::div[1]/field[@name='city']" position="after">
                    <t t-if="record.thana_id.raw_value">
                        <span t-if="record.city.raw_value">, </span>
                        <t t-esc="record.thana_id.value.split('(')[0].trim()"/>,
                        <t t-esc="record.state_id.value.split('(')[0].trim()"/>
                    </t>
                </xpath>
            </field>
        </record>

        <record id="view_partner_form_inherit_thana" model="ir.ui.view">
            <field name="name">res.partner.form.thana</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='city']" position="after">
                    <field name="thana_id" placeholder="Thana" domain="[('state_id', '=', state_id)]" options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>




        <record id="book_shop_res_thana_tree_view" model="ir.ui.view">
            <field name="name">book.shop.res.thana.tree</field>
            <field name="model">res.thana</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
<!--                    <field name="code"/>-->
                    <field name="state_id"/>
                </list>
            </field>
        </record>
        <record id="book_shop_res_thana_action" model="ir.actions.act_window">
            <field name="name">Thanas</field>
            <field name="res_model">res.thana</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="book_shop_res_thana_tree_view"/>
        </record>
    </data>
</odoo>