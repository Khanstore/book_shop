<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paper_quality_offset" model="paper.quality">
        <field name="name">Offset </field>
        <field name="description">Offset paper</field>
    </record>
    <record id="paper_color_white" model="book.paper.color">
        <field name="name">White </field>
        <field name="description">White Color</field>
    </record>
    <record id="paper_color_of_white" model="book.paper.color">
        <field name="name">Of-White </field>
        <field name="description">Of-White Color</field>
    </record>
    <record id="paper_type_white_offset_80" model="paper.type">
        <field name="gsm">80</field>
        <field name="paper_quality" ref="paper_quality_offset"/>
        <field name="paper_color" ref="paper_color_white"/>
    </record>
    <record id="paper_type_white_offset_60" model="paper.type">
        <field name="gsm">60</field>
        <field name="paper_quality" ref="paper_quality_offset"/>
        <field name="paper_color" ref="paper_color_white"/>
    </record>
    <record id="paper_type_of_white_offset_80" model="paper.type">
        <field name="gsm">80</field>
        <field name="paper_quality" ref="paper_quality_offset"/>
        <field name="paper_color" ref="paper_color_of_white"/>
    </record>

</odoo>