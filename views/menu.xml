<odoo>
    <data>


        <menuitem id="shop_menu_root"
                  name="Shop"
                  web_icon="book_shop,static/icon.png"
                  active="True"
                  sequence="30">

            <menuitem id="sale_order_menu"
                      name="Orders"
                      sequence="10">

                <menuitem id="menu_sale_quotations"
                          action="sale.action_quotations_with_onboarding"
                          groups="sales_team.group_sale_salesman"
                          sequence="10"/>

                <menuitem id="menu_sale_order"
                          name="Orders"
                          action="sale.action_orders"
                          groups="sales_team.group_sale_salesman"
                          sequence="20"/>
                <menuitem id="menu_sale_order_invoice"
                          action="sale.action_orders_to_invoice"
                          sequence="20"/>

                <menuitem id="report_sales_team"
                          name="Sales Teams"
                          action="sales_team.crm_team_action_sales"
                          groups="sales_team.group_sale_manager"
                          sequence="30"/>


                <menuitem id="menu_sale_order_upselling"
                          action="sale.action_orders_upselling"
                          sequence="20"/>

            </menuitem>


            <menuitem id="res_partner_menu"
                      action="account.res_partner_action_customer"
                      groups="sales_team.group_sale_salesman"
                      sequence="40">
            </menuitem>
            <menuitem id="pos_menu"
                      name="POS"
                      groups="sales_team.group_sale_salesman"
                      sequence="40">
                <menuitem id="pos_dashboard" name="Dashboard" action="point_of_sale.action_pos_config_kanban" sequence="2" groups="point_of_sale.group_pos_manager,point_of_sale.group_pos_user"/>
                <menuitem id="menu_ppos_order" action="point_of_sale.action_pos_pos_form" sequence="3" groups="point_of_sale.group_pos_manager,point_of_sale.group_pos_user"/>
                <menuitem id="menu_pos_session" action="point_of_sale.action_pos_session" sequence="4" groups="point_of_sale.group_pos_manager,point_of_sale.group_pos_user"/>
                <menuitem id="menu_pos_payments" action="point_of_sale.action_pos_payment_form" sequence="5" groups="point_of_sale.group_pos_manager,point_of_sale.group_pos_user"/>
                <menuitem id="menu_pos_payment_method" action="point_of_sale.action_pos_payment_method_form" sequence="6" groups="point_of_sale.group_pos_manager,point_of_sale.group_pos_user"/>
                <menuitem id="menu_pos_product_categories" action="point_of_sale.product_pos_category_action" sequence="7" groups="point_of_sale.group_pos_manager,point_of_sale.group_pos_user"/>
            </menuitem>

            <menuitem id="product_menu_catalog"
                      name="Products"
                      groups="sales_team.group_sale_salesman"
                      sequence="30">
                <menuitem id="menu_product_template_action"
                          action="sale.product_template_action"
                          sequence="10"/>
                <menuitem id="menu_products"
                          action="product.product_normal_action_sell"
                          groups="product.group_product_variant"
                          sequence="20"/>
                <menuitem id="menu_product_pricelist_main"
                          name="Sale Pricelists"
                          action="product.product_pricelist_action2"
                          groups="product.group_product_pricelist"
                          sequence="30"/>
                <menuitem id="menu_purchase_pricelist_main"
                          name="Purchase Pricelists"
                          action="product.product_supplierinfo_type_action"
                          groups="product.group_product_pricelist"
                          sequence="30"/>
                <menuitem id="menu_product_combo"
                          name="Combo"
                          action="product.product_combo_action"
                          groups="product.group_product_pricelist"
                          sequence="31"/>
            </menuitem>

            <menuitem id="purchase_menu_root"
                      name="Purchase"
                      sequence="40">
                <menuitem id="menu_purchase_order"
                          name="Purchase Orders"
                          action="purchase.purchase_rfq"
                          groups="purchase.group_purchase_user"
                          sequence="10"/>
                <menuitem action="purchase.purchase_form_action"
                          name="Purchase ooOrders"
                          id="menu_purchase_form_action"
                          sequence="6"/>

            </menuitem>

            <menuitem name="Invoicing"
                      id="menu_finance"
                      groups="account.group_account_readonly,account.group_account_invoice"
                      sequence="55">
                <menuitem id="menu_board_journal_1"
                          name="Dashboard"
                          action="account.open_account_journal_dashboard_kanban"
                          groups="account.group_account_basic"
                          sequence="1"/>
                <menuitem id="menu_finance_receivables"
                          name="Customers"
                          sequence="2"/>
                <menuitem id="menu_action_move_out_invoice_type"
                          action="account.action_move_out_invoice_type"
                          sequence="1"/>
                <menuitem id="menu_action_move_out_refund_type"
                          action="account.action_move_out_refund_type"
                          sequence="2"/>
                <menuitem id="menu_action_move_out_receipt_type"
                          action="account.action_move_out_receipt_type"
                          groups="account.group_sale_receipts"
                          sequence="3"/>
                <menuitem id="menu_action_account_payments_receivable"
                          name="Payments"
                          action="account.action_account_payments"
                          sequence="15"/>
            </menuitem>


            <menuitem id="cash_transaction_menu"
                      name="Cash"
                      sequence="20">
                <menuitem id="menu_action_account_payments_receivable"
                          name="Receive"
                          action="account.action_account_payments"
                          sequence="15"/>

                <menuitem id="menu_action_account_payments_payable"
                          name="Payments"
                          action="account.action_account_payments_payable"
                          sequence="20"/>

            </menuitem>


            <menuitem id="inventory_menu_root"
                      name="Inventory"
                      sequence="40">
                <menuitem id="inventory_overview"
                          name="Overview"
                          sequence="40" action="stock.stock_picking_type_action"/>

                <menuitem id="menu_stock_warehouse_mgmt" name="Operations" sequence="2">
                    <menuitem id="menu_stock_transfers" name="Transfers" sequence="1"
                              action="stock.action_picking_tree_incoming"/>
                    <menuitem id="menu_stock_adjustments" name="Adjustments" sequence="3"
                              action="stock.action_picking_tree_outgoing"/>

                </menuitem>
                <menuitem id="menu_stock_adjustments_root" name="Adjustments" sequence="3">
                    <menuitem id="menu_stock_adjustments" name="Adjustments" sequence="3"
                              action="stock.action_view_inventory_tree"/>
                </menuitem>
            </menuitem>

        </menuitem>
    </data>
</odoo>

