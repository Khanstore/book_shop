<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="daily_admin_report_sales">
            <h4>Sales</h4>
            <div class="row">
                <div class="col-1">Date</div>
                <div class="col-1">Order No</div>
                <div class="col-1">Partner</div>
                <div class="col-1">State</div>
                <div class="col-1">amount</div>
            </div>
            <t t-set="total_sales" t-value="0.0"/>
            <t t-foreach="docs.sales_new" t-as="sale">
                <div class="row">
                    <div class="col-1">
                        <t t-esc="sale.date_order"/>
                    </div>
                    <div class="col-1">
                        <t t-esc="sale.name"/>
                    </div>
                    <div class="col-1">
                        <t t-esc="sale.partner_id.name"/>
                        (<t t-esc="sale.partner_id.total_balance"/>)
                    </div>
                    <div class="col-1">
                        <t t-esc="sale.state"/>
                    </div>
                    <div class="col-1">
                        <t t-esc="sale.amount_total"/>
                    </div>
                </div>
                <t t-set="total_sales" t-value="total_sales+sale.amount_total"/>
                <t t-if="docs.mode=='long'">
                    <div class="row">
                        <div class="col-1"></div>
                        <div class="col-1">Product</div>
                        <div class="col-1">Qty</div>
                        <div class="col-1">Rate</div>
                        <div class="col-1">tax</div>
                        <div class="col-1">Total</div>
                    </div>
                    <t t-foreach="sale.order_line" t-as="line">
                        <div class="row">
                            <div class="col-1"></div>
                            <div class="col-1">
                                <t t-esc="line.product_id.name"/>
                            </div>
                            <div class="col-1">
                                <t t-esc="line.product_uom_qty"/>
                                <t t-esc="line.product_uom.name"/>
                            </div>
                            <div class="col-1">
                                <t t-esc="line.price_unit"/>
                            </div>
                            <div class="col-1">
                                <t t-esc="line.price_tax"/>
                            </div>
                            <div class="col-1">
                                <t t-esc="line.price_total"/>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
            <div class="row">
                <div class="col-1">Total</div>
                <div class="col-1"></div>
                <div class="col-1"></div>
                <div class="col-1"></div>
                <div class="col-1">
                    <t t-esc="total_sales"/>
                </div>
            </div>


        </template>
        <template id="daily_admin_report_quote">
            <h4>Quotations</h4>
            <div class="row">
                <div class="col-1">Order No</div>
                <div class="col-1">Partner</div>
                <div class="col-1">State</div>
                <div class="col-1">amount</div>
            </div>
            <t t-foreach="docs.quote_new" t-as="quote">
                <div class="row">
                    <div class="col-1">
                        <t t-esc="quote.name"/>
                    </div>
                    <div class="col-1">
                        <t t-esc="quote.partner_id.name"/>
                        (<t t-esc="quote.partner_id.total_balance"/>)
                    </div>
                    <div class="col-1">
                        <t t-esc="quote.state"/>
                    </div>
                    <div class="col-1">
                        <t t-esc="quote.amount_total"/>
                    </div>
                </div>
                <t t-if="docs.mode=='long'">
                    <div class="row">
                        <div class="col-1"></div>
                        <div class="col-1">Product</div>
                        <div class="col-1">Qty</div>
                        <div class="col-1">Rate</div>
                        <div class="col-1">tax</div>
                        <div class="col-1">Total</div>
                    </div>
                    <t t-foreach="quote.order_line" t-as="line">
                        <div class="row">
                            <div class="col-1"></div>
                            <div class="col-1">
                                <t t-esc="line.product_id.name"/>
                            </div>
                            <div class="col-1">
                                <t t-esc="line.product_uom_qty"/>
                                <t t-esc="line.product_uom.name"/>
                            </div>
                            <div class="col-1">
                                <t t-esc="line.price_unit"/>
                            </div>
                            <div class="col-1">
                                <t t-esc="line.price_tax"/>
                            </div>
                            <div class="col-1">
                                <t t-esc="line.price_total"/>
                            </div>
                        </div>
                    </t>
                </t>
            </t>


        </template>

        <template id="daily_admin_report">
            <t t-call="web.html_container">
                <t t-call="web.internal_layout">
                    <div class="page">
                        <h3 class="mb32">Daily Report</h3>
                        <h5>from
                            <t t-esc="docs.date_start"/>
                            to
                            <t t-esc="docs.date_end"/>
                        </h5>
                        <t t-call="book_shop.daily_admin_report_sales"/>

                        <t t-call="book_shop.daily_admin_report_quote"/>

                        <h4>payments</h4>
                        <div class="row">
                            <div class="col-1">Name</div>
                            <div class="col-1">Date</div>
                            <div class="col-1">Partner</div>
                            <div class="col-1">State</div>
                            <div class="col-1">Journal</div>
                            <div class="col-1">Reference</div>
                            <div class="col-1">Memo</div>
                            <div class="col-1">Credit</div>
                            <div class="col-1">Debit</div>
                        </div>
                        <t t-set="total_credit" t-value="0.0"/>
                        <t t-set="total_debit" t-value="0.0"/>
                        <t t-foreach="docs.payment_new" t-as="payment">
                            <div class="row">
                                <div class="col-1">
                                    <t t-esc="payment.name"/>
                                </div>
                                <div class="col-1">
                                    <t t-esc="payment.date"/>
                                </div>
                                <div class="col-1">
                                    <t t-esc="payment.partner_id.name"/>
                                    (<t t-esc="payment.partner_id.total_balance"/>)
                                </div>
                                <div class="col-1">
                                    <t t-esc="payment.state"/>
                                </div>
                                <div class="col-1">
                                    <t t-esc="payment.journal_id.name"/>
                                </div>
                                <div class="col-1">
                                    <t t-esc="payment.memo"/>
                                </div>
                                <div class="col-1">
                                    <t t-esc="payment.payment_reference"/>
                                </div>
                                <t t-if="payment.payment_type=='inbound'">
                                    <div class="col-1">
                                        <t t-esc="payment.amount"/>
                                        <t t-set="total_credit" t-value="total_credit+payment.amount"/>
                                    </div>
                                    <div class="col-1">
                                        0.00
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="col-1">
                                        0.00
                                    </div>
                                    <div class="col-1">

                                        <t t-set="total_debit" t-value="total_debit+payment.amount"/>
                                        <t t-esc="payment.amount"/>
                                    </div>
                                </t>
                            </div>

                        </t>
                        <div class="row">
                            <div class="col-1">Total</div>
                            <div class="col-1"></div>
                            <div class="col-1"></div>
                            <div class="col-1"></div>
                            <div class="col-1">Difference</div>
                            <div class="col-1">
                                <t t-esc="total_credit-total_debit"/>
                            </div>
                            <div class="col-1"></div>
                            <div class="col-1">
                                <t t-esc="total_credit"/>
                            </div>
                            <div class="col-1">
                                <t t-esc="total_debit"/>
                            </div>
                        </div>
                        <h4>Balance</h4>
                        <div class="row">
                            <div class="col-1">Journal</div>
                            <div class="col-1 text-center">Opening Balance</div>
                            <div class="col-1 text-center">closing Balance</div>
                            <div class="col-1 text-center">Change</div>
                        </div>

                        <!--                        Todo journal Balance=direct_payment+running_balance-->
                        <t t-set="starting_direct_payment" t-value="docs._get_direct_bank_payments(docs.date_start)"/>
                        <t t-set="starting_running_balance"
                           t-value="docs._get_journal_dashboard_bank_running_balance(docs.date_start)"/>

                        <t t-set="ending_direct_payment" t-value="docs._get_direct_bank_payments(docs.date_end,True)"/>
                        <t t-set="ending_running_balance"
                           t-value="docs._get_journal_dashboard_bank_running_balance(docs.date_end ,True)"/>
                        <t t-set="starting_balance_total" t-value="0.0"/>
                        <t t-set="ending_balance_total" t-value="0.0"/>
                        <t t-set="changing_balance_total" t-value="0.0"/>


                        <t t-foreach="docs.journals" t-as="journal">
                            <div class="row">

                                <div class="col-1">
                                    <t t-esc="journal.name"/>
                                </div>
                                <div class="col-1">
                                    <t t-set="starting_balance"
                                       t-value="starting_direct_payment[journal.id][1]+ starting_running_balance[journal.id][1]"/>
                                    <t t-esc="starting_balance"/>
                                    <t t-set="starting_balance_total"
                                       t-value="starting_balance_total+starting_balance"/>
                                </div>


                                <div class="col-1">
                                    <t t-set="ending_balance" t-value="ending_direct_payment[journal.id][1]+ ending_running_balance[journal.id][1]"/>
                                    <t t-esc="ending_balance"/>
                                    <t t-set="ending_balance_total" t-value="ending_balance_total+ending_balance"/>
                                </div>
                                <div class="col-1">
                                    <t t-set="changing_balance" t-value="ending_balance-starting_balance"/>
                                    <t t-esc="changing_balance"/>
                                    <t t-set="changing_balance_total" t-value="changing_balance_total+changing_balance"/>
                                </div>

                            </div>
                        </t>
                        <div class="row">
                            <div class="col-1">Total</div>
                            <div class="col-1 text-end">
                                <t t-esc="starting_balance_total"/>
                            </div>
                            <div class="col-1 text-end">
                                <t t-esc="ending_balance_total"/>
                            </div>
                            <div class="col-1 text-end">
                                <t t-esc="changing_balance_total"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>



        <record id="report_daily_admin_report" model="ir.actions.report">
            <field name="name">Daily Admin Report</field>
            <field name="model">book.shop.daily.statement</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">book_shop.daily_admin_report</field>
            <field name="report_file">book_shop.daily_admin_report</field>
            <field name="binding_model_id" ref="model_book_shop_daily_statement"/>
            <!--            <field name="paperformat_id" ref="product.paperformat_label_sheet_dymo"/>-->
            <field name="print_report_name">'Daily Report - %s to %s' % (object.date_start,object.date_end)</field>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>