<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="sale_order_partner_balance_view" model="ir.ui.view">
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="name">sale.order.partner.balance</field>
            <field name="model">sale.order</field>
            <field name="priority">2</field>
            <field name="arch" type="xml">
                <field name="validity_date" position="before">
                    <!--fixme change colour for negative value-->
                    <field name="partner_balance"/>
                </field>
                <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
                </xpath>

            </field>
        </record>

        <record id="sale_order_history_view" model="ir.ui.view">
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="name">sale.order.history.form</field>
            <field name="model">sale.order</field>
            <field name="priority">2</field>
            <field name="arch" type="xml">
                <field name="price_unit" position="after">
                   <button name="action_sale_history" type="object" icon="fa-history" title="Sale History" invisible="not id"/>
                </field>

            </field>
        </record>

        <record id="sale_order_partner_image_view" model="ir.ui.view">
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="name">sale.order.partner.image</field>
            <field name="model">sale.order</field>
            <field name="priority">2</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="widget">many2one_avatar_user</attribute>
                </xpath>
            </field>
        </record>

        <record id="sale_history_tree" model="ir.ui.view">
        <field name="name">sale.history.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list create="false" default_order="order_id asc" action="action_open_order" type="object">
                <field name="currency_id" column_invisible="True"/>
                <field name="order_id" widget="many2one"/>
                <field name="order_partner_id" string="Buyer"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="product_uom_qty" string="Quantity"/>
                <field name="price_unit" widget="monetary"/>
                <field name="price_subtotal" widget="monetary" string="Total Untaxed"/>
                <field name="state" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sale_history_pivot" model="ir.ui.view">
         <field name="name">sale.history.pivot</field>
         <field name="model">sale.order.line</field>
         <field name="arch" type="xml">
             <pivot>
                <field name="price_total" string="Total sold amount" type="measure"/>
                <field name="product_uom_qty" string="Total Qty sole" type="measure"/>
             </pivot>
         </field>
    </record>

     <record id="sale_history_graph" model="ir.ui.view">
         <field name="name">sale.history.graph</field>
         <field name="model">sale.order.line</field>
         <field name="arch" type="xml">
             <graph type="line">
                <field name="date_order" interval="month"/>
                <field name="product_uom_qty" type="measure"/>
             </graph>
         </field>
    </record>


        <record id="action_sale_history" model="ir.actions.act_window">
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="view_id" ref="book_shop.sale_history_tree"/>
        <field name="context">{
                'search_default_order_state': 1,
                'search_default_order_date_last_year': 1,
                'search_default_groupby_supplier': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Sale order were made for this product yet!
            </p>
        </field>
    </record>


    </data>
</odoo>
