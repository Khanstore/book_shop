        <template id="daily_admin_report_journal">
            <table class="bordered-table">Balance
                        <thead>
                            <tr>
                            <td>Journal</td>
                            <td class="col-1 text-center">Opening Balance</td>
                            <td class="col-1 text-center">closing Balance</td>
                            <td class="col-1 text-center">Change</td>
                            </tr>
                        </thead>

                        <!--                        Todo journal Balance=direct_payment+running_balance-->
                        <t t-set="starting_direct_payment" t-value="docs._get_direct_bank_payments(docs.date_start)"/>
                        <t t-set="starting_running_balance"   t-value="docs._get_journal_dashboard_bank_running_balance(docs.date_start)"/>

                        <t t-set="ending_direct_payment" t-value="docs._get_direct_bank_payments(docs.date_end,True)"/>
                        <t t-set="ending_running_balance"   t-value="docs._get_journal_dashboard_bank_running_balance(docs.date_end ,True)"/>
                        <t t-set="starting_balance_total" t-value="0.0"/>
                        <t t-set="ending_balance_total" t-value="0.0"/>
                        <t t-set="changing_balance_total" t-value="0.0"/>

                        <tbody>

                            <tr t-foreach="docs.journals" t-as="journal">

                                    <td>
                                        <t t-esc="journal.name"/>
                                    </td>
                                    <td>
                                        <t t-set="starting_balance"
                                           t-value="starting_direct_payment[journal.id][1]+ starting_running_balance[journal.id][1]"/>
                                        <t t-esc="starting_balance"/>
                                        <t t-set="starting_balance_total"
                                           t-value="starting_balance_total+starting_balance"/>
                                    </td>


                                    <td>
                                        <t t-set="ending_balance"
                                           t-value="ending_direct_payment[journal.id][1]+ ending_running_balance[journal.id][1]"/>
                                        <t t-esc="ending_balance"/>
                                        <t t-set="ending_balance_total" t-value="ending_balance_total+ending_balance"/>
                                    </td>
                                    <td>
                                        <t t-set="changing_balance" t-value="ending_balance-starting_balance"/>
                                        <t t-esc="changing_balance"/>
                                        <t t-set="changing_balance_total"
                                           t-value="changing_balance_total+changing_balance"/>
                                    </td>
                            </tr>
                        </tbody>
                <tfoot>

                    <tr >
                        <td>Total</td>
                        <td class="col-1 text-end">
                            <t t-esc="starting_balance_total"/>
                        </td>
                        <td class="col-1 text-end">
                            <t t-esc="ending_balance_total"/>
                        </td>
                        <td class="col-1 text-end">
                            <t t-esc="changing_balance_total"/>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </template>

        <template id="daily_admin_report">
            <t t-call="web.html_container">
                <t t-call="web.internal_layout">
                    <style>
                        /* General layout */
                        body {
                        font-family: 'Lato', sans-serif;
                        font-size: 12px;
                        color: #333;
                        margin: 0;
                        padding: 0;
                        }

                        /* Header and footer */
                        .header, .footer {
                        text-align: center;
                        font-size: 10px;
                        color: #777;
                        padding: 0px 0;
                        border-bottom: 1px solid #ccc;
                        }

                        /* Table styling */
                        table.bordered-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-top: 10px;
                        }

                        table.bordered-table th, table.bordered-table td {
                        border: 1px solid #ccc;
                        padding: 6px;
                        text-align: left;
                        }

                        table.bordered-table th {
                        background-color: #f2f2f2;
                        font-weight: bold;
                        }

                        /* Row striping */
                        table.bordered-table tr:nth-child(even) {
                        background-color: #fafafa;
                        }

                        /* Section titles */
                        .section-title {
                        font-size: 14px;
                        font-weight: bold;
                        margin-top: 20px;
                        margin-bottom: 10px;
                        color: #2E86C1;
                        }

                        /* Totals and summary */
                        .total-line {
                        font-weight: bold;
                        text-align: right;
                        padding-top: 10px;
                        }

                        /* Optional Bengali font integration */
                        @font-face {
                        font-family: 'SolaimanLipi';
                        src: url('/your/path/SolaimanLipi.ttf') format('truetype');
                        }

                        .bengali-text {
                        font-family: 'SolaimanLipi', sans-serif;
                        font-size: 13px;
                        }

                    </style>

                    <div class="page">

                        <h3 class="mb32  header">Daily Report</h3>
                        <t t-if="docs.date_start==docs.date_end">
                            <h5><t t-esc="docs.date_start"/> </h5>
                        </t>
                        <t t-else="">
                            <h5 class="header">from
                                <t t-esc="docs.date_start"/>
                                to
                                <t t-esc="docs.date_end"/>
                            </h5>
                        </t>
                        <t t-call="book_shop.daily_admin_report_sales"/>

                        <t t-call="book_shop.daily_admin_report_quote"/>
                        <t t-call="book_shop.daily_purchase"/>
                        <t t-call="book_shop.daily_admin_done_payment"/>
                        <t t-call="book_shop.daily_admin_pending_payment"/>

                        <t t-call="book_shop.daily_admin_report_journal"/>
                    </div>
                </t>
            </t>
        </template>


        <record id="report_daily_admin_report" model="ir.actions.report">
            <field name="name">Daily Admin Report</field>
            <field name="model">book.shop.daily.statement</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">book_shop.daily_admin_report</field>
            <field name="report_file">book_shop.daily_admin_report</field>
            <field name="binding_model_id" ref="model_book_shop_daily_statement"/>
            <!--            <field name="paperformat_id" ref="product.paperformat_label_sheet_dymo"/>-->
            <field name="print_report_name">'Daily Report - %s to %s' % (object.date_start,object.date_end)</field>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>