<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for Book page -->
    <template id="book_shop" name="Books">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container">
                    <div class="row o_grid_mode" data-row-count="10">
                        <div class="o_grid_item g-col-lg-4 g-height-10 col-lg-4 o_colored_level" data-name="Box"
                             style="z-index: 1; grid-area: 1 / 1 / 11 / 5;">
                            <h1 class="display-3">
