<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="sale_order_partner_balance_view" model="ir.ui.view">
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="name">sale.order.partner.balance</field>
            <field name="model">sale.order</field>
            <field name="priority">2</field>
            <field name="arch" type="xml">
                <field name="validity_date" position="before">
                    <!--fixme change colour for negative value-->
                    <field name="partner_balance"/>
                </field>
                <button id="send_by_email_primary" position="after">
                    <button name="action_complete_invoice_delivery" id="complete_invoice_and_delivery"
                            string="Delivery-inv-pay" type="object" data-hotkey="m" invisible="state != 'draft'"
                            class="btn-primary" context="{'validate_analytic': True, 'check_document_layout': True}"/>

                </button>
            </field>
        </record>
        <record id="sale_order_whatsapp_message" model="ir.ui.view">
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="name">sale.order.whatsapp.message</field>
            <field name="model">sale.order</field>
            <field name="priority">2</field>
            <field name="arch" type="xml">

                <button id="send_by_email_primary" position="after">
                    <button name="action_send_whatsapp" id="send_whatsapp"
                            string="send Whatsapp" type="object" data-hotkey="m" invisible="state != 'draft'"
                            class="btn-primary" />

                </button>
            </field>
        </record>


    </data>
</odoo>
