<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_dev_todo_tree" model="ir.ui.view">
        <field name="name">dev.todo.tree</field>
        <field name="model">dev.todo</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="is_done"/>
                <field name="app_name"/>
                <field name="name"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_dev_todo_form" model="ir.ui.view">
        <field name="name">dev.todo.form</field>
        <field name="model">dev.todo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="is_done"/>
                        <field name="name"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dev_todo" model="ir.actions.act_window">
        <field name="name">Developer To-Do</field>
        <field name="res_model">dev.todo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dev_root" name="Developer" sequence="100"
        web_icon="book_shop,todo_applet/icon.png"
    />
    <menuitem id="menu_dev_todo" name="To-Do Checklist" parent="menu_dev_root" sequence="10" action="action_dev_todo"/>
</odoo>
