<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="daily_admin_report_sales">
            <div class="section-title">Sales</div>
            <table class="bordered-table">
                <thead>
                    <tr>
                        <t t-if="docs.date_start!=docs.date_end">
                            <th>Date</th>
                        </t>
                        <th>Order No</th>
                        <th>Partner</th>
                        <th>State</th>
                        <th>amount</th>
                    </tr>

                </thead>
                <tbody>

                    <t t-set="total_sales" t-value="0.0"/>
                    <tr t-foreach="docs.sales_new" t-as="sale">
                        <t t-if="docs.date_start!=docs.date_end">
                            <td>
                            <t t-esc="sale.date_order"/>
                            </td>
                        </t>
                        <td>
                            <t t-esc="sale.name"/>
                        </td>
                        <td>
                            <t t-esc="sale.partner_id.name"/>
                            (<t t-esc="sale.partner_id.total_balance"/>)
                        </td>
                        <td>
                            <t t-esc="sale.state"/>
                        </td>
                        <td>
                            <t t-esc="sale.amount_total"/>
                        </td>
                        <t t-set="total_sales" t-value="total_sales+sale.amount_total"/>
                        <t t-if="docs.mode=='long'">
                            <div class="row">
                                <div></div>
                                <div>Product</div>
                                <div>Qty</div>
                                <div>Rate</div>
                                <div>tax</div>
                                <div>Total</div>
                            </div>
                            <t t-foreach="sale.order_line" t-as="line">
                                <div class="row">
                                    <div></div>
                                    <div>
                                        <t t-esc="line.product_id.name"/>
                                    </div>
                                    <div>
                                        <t t-esc="line.product_uom_qty"/>
                                        <t t-esc="line.product_uom.name"/>
                                    </div>
                                    <div>
                                        <t t-esc="line.price_unit"/>
                                    </div>
                                    <div>
                                        <t t-esc="line.price_tax"/>
                                    </div>
                                    <div>
                                        <t t-esc="line.price_total"/>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>

                        <td>Total</td>
                        <t t-if="docs.date_start!=docs.date_end">
                            <th></th>
                        </t>
                        <td></td>
                        <td></td>
                        <td>
                            <t t-esc="total_sales"/>
                        </td>
                    </tr>
                </tfoot>

            </table>
        </template>

